# terminal-setting-kit Ghostty 설정. kit이 관리합니다. 바꾸려면 `terminal-setting customize`(메뉴)나 `terminal-setting set`, 그 밖은 ~/.config/ghostty/local에.
# Every Ghostty window opens Herdr (one persistent session).
command = {{HERDR}}
font-family = Geist Mono
font-family = Apple SD Gothic Neo
font-size = 16
font-style = Medium
theme = {{THEME}}
background-opacity = 1.0
background-blur = false
macos-titlebar-style = transparent
cursor-style = block
mouse-hide-while-typing = true
# Treat both Option keys as terminal Alt/Meta so shell bindings such as
# Option+Backspace work without per-key Ghostty overrides.
macos-option-as-alt = false
# Option types macOS characters (e.g. Option+Shift+9 = ·); these Option+letter
# chords stay Alt for zsh word editing and Claude Code (model, fast, thinking).
keybind = alt+key_b=esc:b
keybind = alt+key_f=esc:f
keybind = alt+key_d=esc:d
keybind = alt+key_y=esc:y
keybind = alt+key_o=esc:o
keybind = alt+key_p=esc:p
keybind = alt+key_t=esc:t
# Terminal scrolling felt too fast; Ghostty defaults are precision:1,discrete:3.
mouse-scroll-multiplier = precision:0.5,discrete:11
copy-on-select = clipboard
link-previews = true
working-directory = home
window-inherit-working-directory = false
window-padding-x = 8
window-padding-y = 8
window-save-state = never
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify,no-bell
notify-on-command-finish-after = 30s

# Send Shift+Enter as CSI-u so terminal TUIs can distinguish it from plain Enter.
# Herdr consumes this CSI-u sequence directly.
keybind = shift+enter=text:\x1b[13;2u
keybind = ctrl+enter=text:\x1b[13;5u

# Cmd+Enter: put `/queue ` at the start of the line and send it, so Claude Code
# waits until all current work ends (a slash command waits for the turn; a
# plain queued message can land between tool calls). Replaces Ghostty's
# fullscreen default; in other panes it types the same text.
keybind = super+enter=text:\x01/queue \r

# Paste text normally. If the clipboard is image-only, let Cmd+V fall through
# to Herdr so its image-paste binding can forward Ctrl+V to the active agent.
keybind = performable:super+v=paste_from_clipboard

{{KEYS}}

# 내 설정: kit 업데이트가 건드리지 않고, 위 설정을 덮어씁니다.
config-file = ?local
