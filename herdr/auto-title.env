# Number in front of tab names: the key (Cmd+1..9) that switches to it.
HERDR_AUTO_TITLE_POSITION=true
# The sidebar is narrow; a branch prefix ("diagnosis › ...") crowds out the title.
HERDR_AUTO_TITLE_BRANCH_MAX=0
# Tabs often hold an agent beside shells or servers; keep the agent's task as the tab name.
HERDR_AUTO_TITLE_PREFER_AGENT=true
# The sidebar shows workspace names, not $topic.
HERDR_AUTO_TITLE_WORKSPACES=false
